# Read by the Supabase CLI for env() values in supabase/config.toml (local stack only).
# Copy to supabase/.env. Use the same values in the app's .env.local.

# Cloudflare Turnstile always-pass test secret (local only).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Standard Webhooks secret for the Send SMS Hook: "v1,whsec_<base64>".
SUPABASE_SEND_SMS_HOOK_SECRET=
# Where GoTrue (in Docker) reaches the Next dev server. Change the port if 3000 is taken.
SUPABASE_SEND_SMS_HOOK_URI=http://host.docker.internal:3000/api/auth/send-otp
# Placeholder: Twilio is enabled locally only so the CLI keeps phone login on (see config.toml).
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=unused-send-sms-hook
